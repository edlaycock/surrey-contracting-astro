---
/**
 * /lp/groundworks-2: B variant of /lp/groundworks for the paid-traffic A/B test.
 * Same skeleton as /lp/demolition-2 (plan: tasks/todo.md, "Landing page v2"),
 * plus a Recent work section of published projects.
 * noindex, out of the sitemap (astro.config filter on "/lp/"), not linked from
 * nav or footer. Guarded post-build by scripts/check-lp.mjs.
 *
 * FAQS is the single source for both the visible FAQ and the FAQPage JSON-LD,
 * so the two cannot drift.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import { ACCREDITATION_LOGOS } from '../../data/homepage';

const LEAD_SOURCE = 'lp_groundworks_2';
const PHONE_LABEL = 'Call 01483 323568';
const PHONE_HREF = 'tel:01483323568';
const QUOTE_LABEL = 'Get a free quote';

const SERVICES = [
  {
    title: 'Foundations and build to DPC',
    img: '/assets/img/services/groundworks-foundations.webp',
    alt: 'Foundation trenches and concrete works on a Surrey site',
    text: 'Strip, trench-fill and raft foundations, slabs and block-and-beam floors, with brickwork and blockwork to DPC.',
  },
  {
    title: 'Utility trenching and drainage',
    img: '/assets/img/services/groundworks-trench.jpg',
    alt: 'Open service trench with drainage pipework being laid',
    text: 'Foul drainage, manholes and inspection chambers, and ducting for water, electricity and gas, coordinated with foundations and levels.',
  },
  {
    title: 'Site preparation',
    img: '/assets/img/services/groundworks-siteprep.jpg',
    alt: 'Site being stripped and levelled ahead of construction',
    text: 'Topsoil stripping, site levelling, temporary access and ground stabilisation, with material reused on site where it can be.',
  },
  {
    title: 'Excavations',
    img: '/assets/img/services/groundworks-excavation.jpg',
    alt: 'Excavator digging foundations on a groundworks site',
    text: 'Excavation for foundations, services and site levels, with muck-away and disposal arranged as part of the job.',
  },
  {
    title: 'Agricultural groundworks',
    img: '/assets/img/services/groundworks-agricultural.jpg',
    alt: 'Agricultural groundworks on a farm site',
    text: 'Access tracks, yard concreting, surface water management, fencing and gates, and land improvement for agricultural sites.',
  },
  {
    title: 'Surface water drainage',
    img: '/assets/img/Surface%20water%20drainage.jpg',
    alt: 'Surface water drainage pipework being installed',
    text: 'Surface water drainage runs, soakaways and connections to existing drainage, laid to your drawings and levels.',
  },
];

const WHY = [
  { fig: '15+ years', text: 'Delivering groundworks, earthworks and demolition across Surrey, London and the South East.' },
  { fig: 'Accredited', text: 'CHAS, SafeContractor, SSIP and SMAS schemes, with CSCS-carded operatives on site.' },
  { fig: 'Safety first', text: 'Written risk assessments and method statements for every job, in place before work starts.' },
  { fig: 'Surrey and the South East', text: 'Working from our base at Send, near Woking, across Surrey, London and the South East.' },
];

const STEPS = [
  { title: 'Free site visit within 5 working days', text: 'We measure the site and check levels, access, services and constraints.' },
  { title: 'Fixed-price itemised quotation', text: 'A written quotation broken down line by line, so you can compare like for like.' },
  { title: 'Programme agreed to your drawings and levels', text: 'We work to your approved drawings, engineer specifications and site levels, and agree the programme before starting.' },
  { title: 'Dig to DPC with one point of contact', text: 'One point of contact runs the job from excavation and drainage through to foundations and build to DPC.' },
];

const PROJECTS = [
  {
    href: '/projects/drainage-ascot',
    tag: 'Drainage',
    title: 'Drainage Installation, Ascot',
    img: '/assets/img/projects/drainage-ascot-4.jpg',
    alt: 'New foul drainage connection at a house in Ascot',
    text: 'New foul drainage installed and connected for a residential property, ready for a new downstairs bathroom.',
  },
  {
    href: '/projects/concrete-base-cobham',
    tag: 'Groundworks',
    title: 'Concrete Base Installation, Premier Inn Cobham',
    img: '/assets/img/projects/concrete-base-cobham-3.jpg',
    alt: 'Reinforced concrete base for a water tank at the Premier Inn, Cobham',
    text: 'Emergency concrete base for a new water tank, completed within 3 days of the initial site visit.',
  },
  {
    href: '/projects/site-clearance-earthworks',
    tag: 'Earthworks',
    title: 'Site Clearance and Earthworks, Farnham',
    img: '/assets/img/projects/site-clearance-earthworks.jpg',
    alt: 'Cleared and levelled land at a residential site in Farnham',
    text: 'Overgrown land cleared after building works, with around 80 tonnes of green waste removed and 100 tonnes of topsoil brought in.',
  },
];

const FAQS = [
  {
    q: 'What groundworks services do you offer?',
    a: 'Strip, trench-fill and raft foundations, block-and-beam floors and build to DPC, foul and surface water drainage, utility trenching and ducting, site preparation, excavation and agricultural groundworks, across Surrey, London and the South East.',
  },
  {
    q: 'Do you work on residential and commercial projects?',
    a: 'Yes. We carry out groundworks for domestic extensions, new-build homes and commercial developments, working to approved drawings and engineer specifications. Recent jobs range from new drainage for a house in Ascot to a concrete base for the Premier Inn in Cobham.',
  },
  {
    q: 'Are you accredited and insured?',
    a: 'Yes. Surrey Contracting holds CHAS, SafeContractor, SSIP and SMAS accreditation, our operatives carry CSCS cards, and we are insured on every project. Written risk assessments and method statements are prepared for every job.',
  },
  {
    q: 'What areas do you cover for groundworks?',
    a: 'Surrey, London and the South East, from our base at Send, near Woking. Areas served include Guildford, Woking, Esher, Epsom, Weybridge, Reigate, Dorking, Kingston and the wider M25 corridor.',
  },
  {
    q: 'How do I get a groundworks quote?',
    a: 'Call 01483 323568 or send the form on this page with your project postcode, a description of the works and any drawings you have. We respond within one working day, visit the site free of charge within 5 working days, and follow up with a fixed-price itemised quotation.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout
  title="Groundworks Contractors Surrey | Foundations, Drainage, Site Prep"
  description="Foundations, build to DPC, drainage, utility trenching and site preparation across Surrey, London and the South East. CHAS, SafeContractor and SSIP accredited. Call 01483 323568."
  path="/lp/groundworks-2"
>
  <meta name="robots" content="noindex,follow" slot="head" />
  <ServiceSchema slot="head" name="Groundworks" slug="lp/groundworks-2" description="Foundations, build to DPC, drainage, utility trenching and site preparation across Surrey, London and the South East." />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

<section class="page-hero lp2-hero">
  <div class="page-hero-bg" aria-hidden="true">
    <div class="page-hero-img" style="background-image:url('/assets/img/services/groundworks-hero.jpg')"></div>
    <div class="page-hero-vignette"></div>
  </div>
  <div class="container page-hero-inner">
    <h1 class="page-title">Surrey groundworks contractors</h1>
    <p class="page-lede">Foundations, drainage, trenching and site preparation for homeowners, developers and commercial clients. Free site visit, one working day response.</p>
    <div class="hero-ctas">
      <a href="#quoteForm" class="btn btn-yellow">{QUOTE_LABEL}</a>
      <a href={PHONE_HREF} class="btn btn-ghost-light">{PHONE_LABEL}</a>
    </div>
  </div>
</section>

<section class="lp2-trust" aria-label="Accreditations">
  <div class="container">
    <ul class="lp2-trust-logos">
      {ACCREDITATION_LOGOS.map(({ logo, alt }) => (
        <li class="acc-badge lp2-badge"><img src={logo} alt={alt} width="160" height="80" loading="lazy" decoding="async" /></li>
      ))}
    </ul>
    <p class="lp2-trust-line">CHAS, SafeContractor and SSIP accredited. CSCS, CITB, NPORS and IPAF carded operatives, insured on every project.</p>
  </div>
</section>

<section class="page-section lp2-services">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Our groundworks services</h2>
      <p class="section-lede">Complete groundworks for residential, commercial and developer-led projects.</p>
    </div>
    <ul class="lp2-tiles">
      {SERVICES.map(({ title, img, alt, text }) => (
        <li class="lp2-tile">
          <img class="lp2-tile-img" src={img} alt={alt} width="320" height="240" loading="lazy" decoding="async" />
          <div class="lp2-tile-body">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="lp2-why">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title light">Why choose Surrey Contracting for groundworks</h2>
    </div>
    <ul class="lp2-why-grid">
      {WHY.map(({ fig, text }) => (
        <li><strong>{fig}</strong><p>{text}</p></li>
      ))}
    </ul>
  </div>
</section>

<section class="page-section page-section-grey lp2-steps">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">How a groundworks job runs with us</h2>
    </div>
    <ol class="lp2-steps-row">
      {STEPS.map(({ title, text }, i) => (
        <li>
          <span class="lp2-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="page-section lp2-work">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Groundworks we have delivered</h2>
    </div>
    <div class="lp2-proj-grid">
      {PROJECTS.map(({ href, tag, title, img, alt, text }) => (
        <a class="proj" href={href}>
          <div class="proj-photo"><img src={img} alt={alt} width="640" height="480" loading="lazy" decoding="async" /></div>
          <div class="proj-meta">
            <span class="proj-tag">{tag}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </a>
      ))}
      <div class="lp2-proj-all">
        <h3>More of our work</h3>
        <p>Groundworks, earthworks and drainage projects across Surrey and the South East.</p>
        <a href="/projects" class="btn btn-ghost-light">View all projects</a>
      </div>
    </div>
  </div>
</section>

<section class="page-section page-section-grey">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Groundworks FAQs</h2>
    </div>
    <div class="faq-list">
      {FAQS.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="page-section">
  <div class="container contact-grid">
    <div class="contact-info">
      <span class="eyebrow eyebrow-yellow">Get your groundworks quote</span>
      <h2 class="section-title">Ready to start your groundworks project?</h2>
      <p>Send us the details and a contracts manager will be in touch within one working day to arrange a free site visit. One point of contact from quote to handover.</p>
      <div class="contact-cards">
        <div class="contact-card">
          <div class="contact-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
          <div>
            <span class="contact-label">Phone</span>
            <a class="contact-value" href={PHONE_HREF}>01483 323568</a>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
          <div>
            <span class="contact-label">Response</span>
            <span class="contact-value">Within one working day</span>
          </div>
        </div>
      </div>
    </div>

    <form class="quote-form contact-form" id="quoteForm" data-ytq-form data-lead-source={LEAD_SOURCE} novalidate>
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label>Company website<input type="text" name="_honeypot" tabindex="-1" autocomplete="off"></label>
      </div>
      <h3 class="form-title">Get a free groundworks quote</h3>
      <div class="qf-row">
        <label><span>Name</span><input required name="name" type="text" placeholder="Your full name"></label>
        <label><span>Phone</span><input required name="phone" type="tel" placeholder="01483 323568"></label>
      </div>
      <label><span>Email</span><input required name="email" type="email" placeholder="you@email.com"></label>
      <label><span>Company / organisation</span><input name="company" type="text" placeholder="Optional"></label>
      <fieldset class="qf-checks">
        <legend>What do you need?</legend>
        <label class="check"><input type="checkbox" name="svc" value="Demolition"><span>Demolition</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Groundworks"><span>Groundworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Bulk Earthworks"><span>Bulk Earthworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Other"><span>Other</span></label>
      </fieldset>
      <label><span>Project postcode</span><input name="postcode" type="text" placeholder="GU1 1AA"></label>
      <label><span>Tell us about the job</span><textarea name="message" rows="5" placeholder="Site type, scale, target start date"></textarea></label>
      <button type="submit" class="btn btn-yellow btn-block">Send enquiry</button>
      <p class="qf-success" id="qfSuccess" hidden>Thanks, we've got it. A contracts manager will be in touch within one working day.</p>
    </form>
  </div>
</section>

<div class="lp-sticky-cta lp2-sticky">
  <div class="container lp-sticky-cta-row">
    <p class="lp-sticky-cta-text">Foundations, drainage or site prep?<span>Free site visit, one working day response.</span></p>
    <a href={PHONE_HREF} class="btn btn-ghost-light">{PHONE_LABEL}</a>
    <a href="#quoteForm" class="btn btn-yellow">{QUOTE_LABEL}</a>
  </div>
</div>
</BaseLayout>
