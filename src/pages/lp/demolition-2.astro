---
/**
 * /lp/demolition-2: B variant of /lp/demolition for the paid-traffic A/B test.
 * Scan-first, trust-first structure (plan: tasks/todo.md, "Landing page v2").
 * noindex, out of the sitemap (astro.config filter on "/lp/"), not linked from
 * nav or footer. Guarded post-build by scripts/check-lp.mjs.
 *
 * FAQS is the single source for both the visible FAQ and the FAQPage JSON-LD,
 * so the two cannot drift.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import { ACCREDITATION_LOGOS } from '../../data/homepage';

const LEAD_SOURCE = 'lp_demolition_2';
const PHONE_LABEL = 'Call 01483 323568';
const PHONE_HREF = 'tel:01483323568';
const QUOTE_LABEL = 'Get a free quote';

const SERVICES = [
  {
    title: 'Full structural demolition',
    img: '/assets/img/demolition-640.webp',
    alt: 'Excavator demolishing a structure on a Surrey site',
    text: 'Complete structural take-downs and partial demolition for renovation, on residential and commercial sites.',
  },
  {
    title: 'Soft strip-out',
    img: '/assets/img/services/demolition-softstrip-640.webp',
    alt: 'Interior soft strip-out with fixtures and fittings removed',
    text: 'Fixtures, fittings, ceilings, partitions and M&E removed while the structural frame stays in place.',
  },
  {
    title: 'Site clearance',
    img: '/assets/img/services/demolition-clearance-640.webp',
    alt: 'Cleared demolition site ready for the next phase of works',
    text: 'Debris, vegetation and redundant structures cleared and waste disposed of responsibly, ready for the next phase.',
  },
  {
    title: 'Concrete crushing',
    img: '/assets/img/services/demolition-crushing-640.webp',
    alt: 'Mobile crusher processing demolition arisings into aggregate',
    text: 'On-site mobile crushing or off-site processing turns arisings into reusable sub-base, fill and drainage aggregate.',
  },
  {
    title: 'Site hoarding and security',
    img: '/assets/img/services/demolition-hoarding-640.webp',
    alt: 'Timber site hoarding around a demolition project',
    text: 'Surface-mounted and dug-in hoarding, Harris fencing and gates, with CCTV and alarms through specialist partners.',
  },
  {
    title: 'Asbestos surveys and licensed removal coordination',
    img: '/assets/img/asbestos-640.webp',
    alt: 'Asbestos survey being carried out before demolition',
    text: 'The refurbishment and demolition survey is arranged first, licensed removal is carried out by an HSE-licensed specialist contractor, and Surrey Contracting sequences the two with the demolition programme.',
  },
];

const WHY = [
  { fig: '15+ years', text: 'Delivering demolition, groundworks and earthworks across Surrey, London and the South East.' },
  { fig: 'Accredited', text: 'CHAS, SafeContractor, SSIP and SMAS schemes, with CSCS-carded operatives on site.' },
  { fig: 'Safety first', text: 'Written risk assessments and method statements for every job, in place before work starts.' },
  { fig: 'Own plant and crews', text: 'Demolition and clearance self-delivered with our own plant and operators, with on-site crushing where space allows.' },
];

const STEPS = [
  { title: 'Free site visit', text: 'A contracts manager is in touch within one working day to arrange a visit and look at access, services and constraints.' },
  { title: 'Quotation', text: 'We price the job from what we saw on site and send you our quote.' },
  { title: 'Survey, RAMS and asbestos sequencing', text: 'The asbestos survey, risk assessments and method statements are in place before anyone starts on site.' },
  { title: 'Demolition, clearance and handover', text: 'One point of contact runs the job through demolition and clearance, with on-site crushing where space allows, to handover.' },
];

const FAQS = [
  {
    q: 'What types of demolition do you carry out?',
    a: 'Full structural demolition, partial demolition for renovation, soft strip-out, site clearance, concrete crushing, and site hoarding and security, for residential and commercial clients across Surrey, London and the South East. Where asbestos is present, we coordinate the survey and the licensed removal by specialist contractors.',
  },
  {
    q: 'Who carries out asbestos removal before a demolition?',
    a: 'Licensed asbestos removal can only be carried out by an HSE-licensed contractor, and Surrey Contracting brings in a licensed specialist for that work. What we do is make sure the refurbishment and demolition survey is in place first, sequence the removal ahead of the demolition, and handle the site access and handover so the two programmes run together rather than as separate packages.',
  },
  {
    q: 'Do you crush concrete on site?',
    a: 'Yes, where space allows. On-site mobile crushing turns demolition arisings into reusable aggregate for sub-base, general fill or drainage, which reduces muck-away and haulage costs. Where the site is too tight, material is processed off site instead.',
  },
  {
    q: 'What areas do you cover for demolition?',
    a: 'Surrey, London and the South East, from our base at Send, near Woking. Areas served include Guildford, Woking, Esher, Epsom, Weybridge, Reigate, Dorking, Kingston and the wider M25 corridor.',
  },
  {
    q: 'How do I get a quote for demolition work?',
    a: 'Call 01483 323568 or send the form on this page. A contracts manager will be in touch within one working day to arrange a free site visit, and you have one point of contact from quote to handover.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout
  title="Demolition Contractors Surrey | Free Site Visit, Free Quote"
  description="Structural demolition, soft strip-out, site clearance and concrete crushing across Surrey, London and the South East. CHAS, SafeContractor and SSIP accredited. Call 01483 323568."
  path="/lp/demolition-2"
>
  <meta name="robots" content="noindex,follow" slot="head" />
  <ServiceSchema slot="head" name="Demolition" slug="lp/demolition-2" description="Structural demolition, soft strip-out, site clearance and concrete crushing across Surrey, London and the South East." />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

<section class="page-hero lp2-hero">
  <div class="page-hero-bg" aria-hidden="true">
    <div class="page-hero-img" style="background-image:url('/assets/img/services/demolition-hero.jpg')"></div>
    <div class="page-hero-vignette"></div>
  </div>
  <div class="container page-hero-inner">
    <h1 class="page-title">Surrey demolition contractors</h1>
    <p class="page-lede">Structural demolition, soft strip and site clearance for homeowners, developers and commercial clients. Free site visit, one working day response.</p>
    <div class="hero-ctas">
      <a href="#quoteForm" class="btn btn-yellow">{QUOTE_LABEL}</a>
      <a href={PHONE_HREF} class="btn btn-ghost-light">{PHONE_LABEL}</a>
    </div>
  </div>
</section>

<section class="lp2-trust" aria-label="Accreditations">
  <div class="container">
    <ul class="lp2-trust-logos">
      {ACCREDITATION_LOGOS.map(({ logo, alt }) => (
        <li class="acc-badge lp2-badge"><img src={logo} alt={alt} width="160" height="80" decoding="async" /></li>
      ))}
    </ul>
    <p class="lp2-trust-line">CHAS, SafeContractor and SSIP accredited. CSCS-carded operatives. Written risk assessments and method statements on every job.</p>
  </div>
</section>

<section class="page-section lp2-services">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Our demolition services</h2>
      <p class="section-lede">From first survey to a cleared site, one team and one point of contact.</p>
    </div>
    <ul class="lp2-tiles">
      {SERVICES.map(({ title, img, alt, text }) => (
        <li class="lp2-tile">
          <img class="lp2-tile-img" src={img} alt={alt} width="320" height="240" loading="lazy" decoding="async" />
          <div class="lp2-tile-body">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="lp2-why">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title light">Why choose Surrey Contracting for demolition</h2>
    </div>
    <ul class="lp2-why-grid">
      {WHY.map(({ fig, text }) => (
        <li><strong>{fig}</strong><p>{text}</p></li>
      ))}
    </ul>
  </div>
</section>

<section class="page-section page-section-grey lp2-steps">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">How a demolition job runs with us</h2>
    </div>
    <ol class="lp2-steps-row">
      {STEPS.map(({ title, text }, i) => (
        <li>
          <span class="lp2-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="page-section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Demolition FAQs</h2>
    </div>
    <div class="faq-list">
      {FAQS.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="page-section page-section-grey">
  <div class="container contact-grid">
    <div class="contact-info">
      <span class="eyebrow eyebrow-yellow">Get your demolition quote</span>
      <h2 class="section-title">Ready to start your demolition project?</h2>
      <p>Send us the details and a contracts manager will be in touch within one working day to arrange a free site visit. One point of contact from quote to handover.</p>
      <div class="contact-cards">
        <div class="contact-card">
          <div class="contact-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.86 19.86 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
          <div>
            <span class="contact-label">Phone</span>
            <a class="contact-value" href={PHONE_HREF}>01483 323568</a>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
          <div>
            <span class="contact-label">Response</span>
            <span class="contact-value">Within one working day</span>
          </div>
        </div>
      </div>
    </div>

    <form class="quote-form contact-form" id="quoteForm" data-ytq-form data-lead-source={LEAD_SOURCE} novalidate>
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label>Company website<input type="text" name="_honeypot" tabindex="-1" autocomplete="off"></label>
      </div>
      <h3 class="form-title">Get a free demolition quote</h3>
      <div class="qf-row">
        <label><span>Name</span><input required name="name" type="text" placeholder="Your full name"></label>
        <label><span>Phone</span><input required name="phone" type="tel" placeholder="01483 323568"></label>
      </div>
      <label><span>Email</span><input required name="email" type="email" placeholder="you@email.com"></label>
      <label><span>Company / organisation</span><input name="company" type="text" placeholder="Optional"></label>
      <fieldset class="qf-checks">
        <legend>What do you need?</legend>
        <label class="check"><input type="checkbox" name="svc" value="Demolition"><span>Demolition</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Groundworks"><span>Groundworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Bulk Earthworks"><span>Bulk Earthworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Other"><span>Other</span></label>
      </fieldset>
      <label><span>Project postcode</span><input name="postcode" type="text" placeholder="GU1 1AA"></label>
      <label><span>Tell us about the job</span><textarea name="message" rows="5" placeholder="Site type, scale, target start date"></textarea></label>
      <button type="submit" class="btn btn-yellow btn-block">Send enquiry</button>
      <p class="qf-success" id="qfSuccess" hidden>Thanks, we've got it. A contracts manager will be in touch within one working day.</p>
    </form>
  </div>
</section>

<div class="lp-sticky-cta lp2-sticky">
  <div class="container lp-sticky-cta-row">
    <p class="lp-sticky-cta-text">Structural or soft strip demolition?<span>Free site visit, one working day response.</span></p>
    <a href={PHONE_HREF} class="btn btn-ghost-light">{PHONE_LABEL}</a>
    <a href="#quoteForm" class="btn btn-yellow">{QUOTE_LABEL}</a>
  </div>
</div>
</BaseLayout>
