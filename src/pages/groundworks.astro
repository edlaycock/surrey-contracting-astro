<style>
  /* Page-scoped only — no global stylesheet changes. */
  /* The shared .page-section pads to 120px top and bottom, which leaves too big
     a gap between the accreditation band and the opening paragraph. Trimmed at
     the top only; the gap below the CTAs still separates this from the first H2. */
  .gw-intro-section { padding: clamp(34px, 4vw, 52px) 0 clamp(56px, 7vw, 88px); }

  .gw-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(30px, 5vw, 60px);
    align-items: center;
  }
  .gw-intro-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background-color: var(--grey-200);
    border: 1px solid var(--border);
  }
  /* Text stays first on narrow screens so the opening paragraph still follows
     straight on from the H1. */
  @media (max-width: 880px) {
    .gw-intro-grid { grid-template-columns: 1fr; }
  }

  .gw-intro,
  .gw-prose { max-width: 76ch; }
  .gw-intro .lede-dark { margin-bottom: 14px; }
  /* In-prose links only — never the .btn CTAs, which keep their own colours. */
  .gw-intro p a:not(.btn),
  .gw-prose p a:not(.btn),
  .gw-steps a:not(.btn) { color: var(--yellow-700); text-decoration: underline; }
  .gw-intro p a:not(.btn):hover,
