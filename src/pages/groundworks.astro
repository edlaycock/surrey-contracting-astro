---
/**
 * Groundworks service page — targets "groundworks contractor Surrey".
 *
 * Each H2 question is followed immediately by a plain, crawlable answer
 * paragraph. Those answers are also the source of the FAQPage JSON-LD below,
 * so the visible text and the structured data cannot drift apart. Keep them
 * that way: edit the constants, not the markup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import { getProjects, urlFor } from '../lib/sanity';

const REVIEWED = '19 August 2026';

/* ── Direct answers ───────────────────────────────────────────────────────────
   Single source of truth: each string is rendered once as the visible answer
   paragraph and once inside the FAQPage JSON-LD, so the two can never drift. */
const A_WHAT =
  'A groundworks contractor prepares a site and constructs the below-ground elements required before the main building work begins. This can include site clearance, excavation, foundations, concrete slabs, drainage, utility trenches, ground stabilisation and build-to-DPC work for residential, commercial and developer-led projects.';

const A_SERVICES =
  'Surrey Contracting provides foundation and build-to-DPC packages, foul and surface water drainage, soakaway construction, utility trenching, site preparation, excavation and agricultural groundworks. The company works on domestic, commercial and developer-led projects across Surrey, London and the South East.';

const A_CHOOSE =
  'Choose a Surrey groundworks contractor by checking relevant project experience, health and safety credentials, plant capability, insurance, written scope and the ability to work from approved drawings. The quotation should define excavation, drainage, foundations, waste removal, exclusions and responsibility for coordinating with engineers, building control and other trades.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does a groundworks contractor in Surrey do?',
      acceptedAnswer: { '@type': 'Answer', text: A_WHAT },
    },
    {
      '@type': 'Question',
      name: 'Which groundworks services does Surrey Contracting provide?',
      acceptedAnswer: { '@type': 'Answer', text: A_SERVICES },
    },
    {
      '@type': 'Question',
      name: 'How should you choose a groundworks contractor in Surrey?',
      acceptedAnswer: { '@type': 'Answer', text: A_CHOOSE },
    },
  ],
};

/* ── Groundworks stages table ── */
const STAGES = [
  ['Site preparation', 'Clearance, topsoil stripping and access preparation', 'A safe, workable site'],
  ['Excavation', 'Reduced-level digs, trenches and spoil removal', 'Correct formation levels'],
  ['Substructure', 'Foundations, concrete and build to DPC', 'Structure ready for the next trade'],
  ['Drainage and services', 'Pipework, chambers, soakaways and ducting', 'Coordinated below-ground infrastructure'],
  ['Reinstatement', 'Backfilling, compaction and surface preparation', 'Site ready for landscaping or the next phase'],
];

/* ── Project evidence ─────────────────────────────────────────────────────────
   Every field below is taken from the published Sanity case study for that
   project (title, location, client, sector and body copy). Nothing here is
   invented: no quantities, dates, durations or results beyond what the case
   study itself states. Projects are only rendered if the CMS returns them. */
const EVIDENCE = [
  {
    slug: 'concrete-base-cobham',
    work: 'Excavation and installation of new base works with 150mm of reinforced concrete for a new water tank.',
    constraint: 'Urgent instruction after the client’s original contractor withdrew at short notice.',
    outcome: 'Works carried out and completed within 3 days of the initial site visit.',
  },
  {
    slug: 'drainage-ascot',
    work: 'New foul drainage installed and connected ready for a downstairs bathroom to be fitted by the client’s builder.',
    constraint: 'Connection into an existing foul system, with core drilling through the building to make the connections.',
    outcome: 'All entry points sealed and work areas made good, ready for the follow-on trade.',
  },
  {
    slug: 'site-clearance-earthworks',
    work: 'Clearance and earthworks to a sizeable section of overgrown land, with soil reused on site and new topsoil levelled into fresh slopes and gradients.',
    constraint: 'Overgrown ground left behind by a completed building programme, requiring clearance before usable levels could be formed.',
    outcome: 'Around 80 tonnes of green waste removed and around 100 tonnes of new topsoil imported, giving the client usable land with a second phase planned.',
  },
  {
    slug: 'southbank-centre',
    work: 'Phased external works including surface-water drainage upgrades, full-depth reconstruction to two service yards and reinstatement of footways and crossings.',
    constraint: 'Delivered around live programming at one of the UK’s busiest cultural venues, with public access maintained.',
    outcome: 'Handover achieved on programme with no impact on ticketed performances; follow-on works commissioned.',
  },
];

const projects = await getProjects();
const bySlug = new Map(projects.map((p) => [p.slug, p]));
const evidence = EVIDENCE.map((e) => ({ ...e, project: bySlug.get(e.slug) })).filter(
  (e): e is typeof e & { project: NonNullable<typeof e.project> } => Boolean(e.project),
);
