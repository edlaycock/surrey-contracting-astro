---
/**
 * Groundworks: Ed's updated mock-up (16 Oct 2026), rendered by ServicePage
 * from SERVICE_PAGES.groundworks.
 *
 * Kept from the previous page, below the design's sections and before the
 * CTA band: the three visible FAQs (verbatim; the same array drives the
 * visible list and the FAQPage JSON-LD) and the "Groundworks by town" links
 * to the location pages.
 */
import ServicePage from '../components/ServicePage.astro';
import { LOCATIONS } from '../data/locations';
---
<ServicePage
  pageKey="groundworks"
  title="Groundworks Contractor Surrey | Foundations & Drainage"
  description="Foundations, drainage, site preparation and groundworks across Surrey. Self-delivered by our own teams. Free measured site visit."
  path="/groundworks"
  active="services"
  crumbs={[{ name: 'Services', href: '/services' }, { name: 'Groundworks' }]}
  service={{ name: 'Groundworks', description: 'Groundworks contractor in Surrey delivering foundations and build to DPC, drainage, utility trenching, excavation and site preparation.' }}
  hideHeroEyebrow
>
  <section class="sp-towns" slot="before-cta">
    <div class="container">
      <h2 class="sp-h2 sp-h2-sm">Groundworks by town</h2>
      <p>We work across Surrey from the yard at Send. Each town page covers the run from the yard, the ground conditions and the access to expect. The full list, with distances, is on our <a href="/areas">areas we cover</a> page.</p>
      <ul class="sp-towns-list">
        {LOCATIONS.map((l) => (
          <li><a href={`/${l.slug}`}>Groundworks in {l.town}</a></li>
        ))}
      </ul>
    </div>
  </section>
</ServicePage>
