---
/**
 * Homepage. A direct-answer paragraph immediately under the H1, the visual
 * sections (services, projects, areas), then the explanatory content in a
 * collapsed FAQ rather than as text blocks, and an author/date note. All
 * copy, the FAQ and the schema fragments come from src/data/homepage.ts so
 * visible text and JSON-LD render from the same strings.
 *
 * Schema on this page: the site-wide business node (BaseLayout) plus FAQPage.
 * No Article, no aggregateRating. scripts/check-homepage.mjs enforces this
 * and the other brief constraints after every build.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  META, DIRECT_ANSWER, AREAS_RESPONSE, FAQS, FAQ_SCHEMA,
  ACCREDITATIONS, REVIEWER, DATES,
} from '../data/homepage';

const faqJsonLd = { '@context': 'https://schema.org', ...FAQ_SCHEMA };
const logos = ACCREDITATIONS.filter((a) => a.logo);
---
<BaseLayout
  title={META.title}
  description={META.description}
  ogTitle={META.title}
  path="/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)} />
  <!-- The hero background is the LCP element but, as a CSS background, it is
       only discovered after the stylesheet parses. Preloading it from the
       document makes it discoverable immediately and lets it fetch at high priority. -->
  <link slot="head" rel="preload" as="image" href="/assets/img/Groundworks_Surrey_Contracting.jpg" fetchpriority="high" />

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-bg" id="heroBg" aria-hidden="true">
    <div class="hero-img hero-img-1"></div>
    <div class="hero-vignette" style="opacity: 0.5"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-slides">
      <article class="hero-slide is-active" data-slide="0">
        <div class="hero-eyebrow">
          <span class="dot"></span>
          Established across Surrey &amp; London
        </div>
        <p class="hero-title">
          Built on Experience.<br>
          <span class="hero-accent">Driven by Quality.</span>
        </p>
        <h1 class="hero-sub">
          Groundworks, Earthworks &amp; Demolition Contractor, Surrey &amp; the Home Counties
        </h1>
        <p class="hero-answer">{DIRECT_ANSWER}</p>
        <div class="hero-ctas">
          <a href="#quote" class="btn btn-yellow">Request a quote</a>
          <a href="#services" class="btn btn-ghost-light">Our services →</a>
        </div>
      </article>
    </div>

    <div class="hero-trust">
      <div class="trust-item"><strong>15+</strong><span>years of experience</span></div>
      <div class="trust-divider"></div>
      <div class="trust-item"><strong>Surrey</strong><span>&amp; the South East</span></div>
      <div class="trust-divider"></div>
      <div class="trust-item"><strong>CHAS</strong><span>accredited</span></div>
    </div>
  </div>

  <a href="#services" class="hero-scroll" aria-label="Scroll to services">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<!-- ============ SERVICE TILES ============ -->
<section class="services" id="services">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2 class="section-title">A Groundworks, Earthworks &amp; Demolition contractor for any site.</h2>
      <p class="section-lede">Three disciplines, one team, one point of contact from first dig to handover.</p>
    </div>

    <div class="svc-grid">
      <a href="/demolition" class="svc-card" style="background-image:url(/assets/img/Demolition.webp)">
        <div class="svc-overlay"></div>
        <div class="svc-meta">
          <h3>Demolition</h3>
          <p>Commercial and residential demolition, from small residential projects to large commercial sites: soft strip-outs, on-site crushing and asbestos removal.</p>
          <span class="svc-arrow">Explore service →</span>
        </div>
      </a>

      <a href="/groundworks" class="svc-card" style="background-image:url(/assets/img/groundworks.webp)">
        <div class="svc-overlay"></div>
        <div class="svc-meta">
          <h3>Groundworks</h3>
          <p>Foundations, foul and surface-water drainage, concrete works and infrastructure works for residential and commercial developments.</p>
          <span class="svc-arrow">Explore service →</span>
        </div>
      </a>

      <a href="/earthworks" class="svc-card" style="background-image:url(/assets/img/bulk-earthworks.jpg)">
        <div class="svc-overlay"></div>
        <div class="svc-meta">
          <h3>Bulk Earthworks</h3>
          <p>From small-scale residential site levelling through to large-scale commercial sites, we specialise in bulk earthworks, excavations and site levelling.</p>
          <span class="svc-arrow">Explore service →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ============ PROJECTS ============ -->
<section class="projects" id="projects">
  <div class="container">
    <div class="section-head split">
      <div>
        <span class="eyebrow">Recent work</span>
        <h2 class="section-title">Projects from across the county.</h2>
      </div>
      <a href="/projects" class="btn btn-outline-dark">View full gallery →</a>
    </div>

    <div class="proj-grid">
      <article class="proj">
        <div class="proj-photo" style="background-image:url('/assets/img/bulk-earthworks.jpg')"></div>
        <div class="proj-meta">
          <span class="proj-tag">Bulk Earthworks</span>
          <h3>Commercial site cut &amp; fill</h3>
          <p>Large-scale excavation and site levelling for a phased commercial development.</p>
        </div>
      </article>

      <article class="proj">
        <div class="proj-photo" style="background-image:url('/assets/img/Demolition2.webp')"></div>
        <div class="proj-meta">
          <span class="proj-tag">Demolition</span>
          <h3>Soft strip &amp; structural demolition</h3>
          <p>Soft strip, structural demolition and on-site crushing, handed over ready for rebuild.</p>
        </div>
      </article>

      <article class="proj">
        <div class="proj-photo" style="background-image:url('/assets/img/brickwork.jpeg')"></div>
        <div class="proj-meta">
          <span class="proj-tag">Groundworks</span>
          <h3>Substructure &amp; foundations</h3>
          <p>Strip foundations, drainage and oversite for a residential extension, from clearance to slab.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============ AREAS ============ -->
<section class="areas" id="areas">
  <div class="container areas-grid">
    <div class="areas-copy">
      <span class="eyebrow eyebrow-yellow">Areas we cover</span>
      <h2 class="section-title light">Which areas does Surrey Contracting cover?</h2>
      <p>Our HQ is based at Send, just outside Woking, but we operate across Surrey, London and the South East. If you're inside the M25 ring or along the A3 corridor, we're a short call out.</p>
      <ul class="areas-list">
        <li>Cobham</li><li>Leatherhead</li><li>Guildford</li><li>Esher</li>
        <li>Woking</li><li>Reigate</li><li>Dorking</li><li>Epsom</li>
        <li>Weybridge</li><li>Kingston</li><li>Redhill</li><li>Surbiton</li>
      </ul>
      <p class="areas-response">{AREAS_RESPONSE}</p>
    </div>
    <div class="areas-map" aria-hidden="true">
      <div class="map-frame">
        <img src="/assets/img/coverage-map.png" loading="lazy" decoding="async" alt="Surrey Contracting coverage area covering Surrey and surrounding regions including Guildford, Woking, Cobham, Leatherhead, Epsom, Kingston upon Thames, Walton-on-Thames, Weybridge, Godalming and Cranleigh." class="map-img">
        <div class="map-pin" aria-hidden="true">
          <span class="pin-dot"></span>
          <span class="pin-ring"></span>
          <span class="pin-label">HQ · Send</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="page-section page-section-grey" id="faq">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Common questions</span>
      <h2 class="section-title">Frequently asked questions</h2>
    </div>
    <div class="faq-list">
      {FAQS.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p set:html={a} />
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============ QUOTE FORM ============ -->
<section class="quote" id="quote">
  <div class="container quote-grid">
    <div class="quote-copy">
      <span class="eyebrow eyebrow-yellow">Get in touch</span>
      <h2 class="section-title light">Request a quote.</h2>
      <p>Tell us about your site and we'll be back inside one working day with a measured site-visit date.</p>
      <div class="quote-direct">
        <div>
          <span class="qd-lbl">Call us</span>
          <a href="tel:01483323568" class="qd-val">01483 323568</a>
        </div>
        <div>
          <span class="qd-lbl">Email us</span>
          <a href="mailto:info@surreycontracting.co.uk" class="qd-val">info@surreycontracting.co.uk</a>
        </div>
        <div>
          <span class="qd-lbl">Our promise</span>
          <span class="qd-val">We respond to every enquiry within one working day, with a free measured site visit within 5 working days.</span>
        </div>
        <div>
          <span class="qd-lbl">Office</span>
          <span class="qd-val">Unit 3, Tannery House, Tannery Lane, Send, Woking, Surrey, GU23 7EF</span>
        </div>
      </div>
    </div>

    <form class="quote-form" id="quoteForm" data-ytq-form novalidate>
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label>Company website<input type="text" name="_honeypot" tabindex="-1" autocomplete="off"></label>
      </div>
      <div class="qf-row">
        <label>
          <span>Name</span>
          <input required name="name" type="text" placeholder="Your full name">
        </label>
        <label>
          <span>Phone</span>
          <input required name="phone" type="tel" placeholder="01483 323568">
        </label>
      </div>
      <label>
        <span>Email</span>
        <input required name="email" type="email" placeholder="you@email.com">
      </label>
      <fieldset class="qf-checks">
        <legend>What do you need?</legend>
        <label class="check"><input type="checkbox" name="svc" value="Demolition"><span>Demolition</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Groundworks"><span>Groundworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Bulk Earthworks"><span>Bulk Earthworks</span></label>
        <label class="check"><input type="checkbox" name="svc" value="Other"><span>Other</span></label>
      </fieldset>
      <label>
        <span>Project postcode</span>
        <input name="postcode" type="text" placeholder="GU1 1AA">
      </label>
      <label>
        <span>Tell us about the job</span>
        <textarea name="message" rows="4" placeholder="Site type, scale, target start date…"></textarea>
      </label>
      <label class="qf-hear">
        <span>Where did you hear about us?</span>
        <select name="source">
          <option value="" selected>Please choose</option>
          <option>Google</option>
          <option>Facebook</option>
          <option>Instagram</option>
          <option>TikTok</option>
          <option>YouTube</option>
          <option>Referral</option>
          <option>Sign Board</option>
          <option>Other</option>
        </select>
      </label>
      <button type="submit" class="btn btn-yellow btn-block">Send enquiry</button>
      <p class="qf-success" id="qfSuccess" hidden>Thanks, we've got it. A contracts manager will be in touch within one working day.</p>
    </form>
  </div>
</section>

<!-- ============ PREVIOUS CLIENTS ============ -->
<section class="clients" id="clients">
  <div class="container">
    <div class="clients-head">
      <span class="eyebrow">Trusted by</span>
      <h2 class="section-title">A few of the clients we've worked with.</h2>
    </div>
  </div>

  <div class="acc-marquee clients-marquee" aria-label="Previous client logos">
    <div class="acc-track clients-track">
      <div class="acc-set">
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/dhl.webp" alt="DHL"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/southbank.webp" alt="Southbank Centre"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/environment-agency.webp" alt="Environment Agency, Registered Waste Carrier"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/gratte-brothers.webp" alt="Gratte Brothers"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/coinstreet.webp" alt="Coin Street"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/hunter-hyland.webp" alt="Hunter &amp; Hyland"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/penningtons.webp" alt="Pennington's Electrical Contractors"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/easigrass.webp" alt="Easigrass, the artificial grass company"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/ocb.webp" alt="OCB Construction"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/denville.webp" alt="Denville Interiors"></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/property-mgmt-hampshire.webp" alt="Property Management Hampshire"></div>
      </div>
      <div class="acc-set" aria-hidden="true">
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/dhl.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/southbank.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/environment-agency.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/gratte-brothers.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/coinstreet.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/hunter-hyland.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/penningtons.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/easigrass.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/ocb.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/denville.webp" alt=""></div>
        <div class="acc-badge client-badge"><img loading="lazy" decoding="async" src="/assets/clients/property-mgmt-hampshire.webp" alt=""></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ ACCREDITATIONS ============ -->
<section class="accs" id="accreditations">
  <div class="container">
    <div class="accs-head">
      <span class="eyebrow">Accreditations &amp; memberships</span>
      <h2 class="section-title">Audited. Verified. Compliant.</h2>
    </div>
  </div>

  <div class="acc-marquee" aria-label="Accreditation logos">
    <div class="acc-track">
      <!-- two copies of the same set for seamless infinite scroll -->
      <div class="acc-set">
        {logos.map((a) => <div class="acc-badge"><img loading="lazy" decoding="async" src={a.logo} alt={a.alt}></div>)}
      </div>
      <div class="acc-set" aria-hidden="true">
        {logos.map((a) => <div class="acc-badge"><img loading="lazy" decoding="async" src={a.logo} alt=""></div>)}
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="acc-register" aria-label="Accreditations and public registers">
      {ACCREDITATIONS.map((a) => (
        <li>
          <strong>{a.name}</strong>
          <span>{a.note}</span>
          {a.registerUrl && <a href={a.registerUrl} target="_blank" rel="noopener noreferrer">{a.registerLabel}</a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ PUBLISHER & DATES ============ -->
<section class="author-note" aria-label="Publisher and review dates">
  <div class="container">
    <p>Published by Surrey Contracting Limited. Reviewed by {REVIEWER.name}, {REVIEWER.role}.</p>
    <p class="author-dates">Published <time datetime={DATES.published}>{DATES.publishedLabel}</time>. Last updated <time datetime={DATES.reviewed}>{DATES.reviewedLabel}</time>.</p>
  </div>
</section>
</BaseLayout>

<style is:global>
  /* Homepage-only additions. Class names are unique to this page. */
  .hero-answer {
    margin: 14px 0 0;
    max-width: 62ch;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.65;
    color: inherit;
    opacity: .92;
  }
  .areas-response { margin-top: 18px; }
  #faq .faq-item p a { color: var(--yellow-700, #9a6c00); text-decoration: underline; }
  #faq .faq-item p a:hover { color: var(--ink, #1a1a1a); }

  .acc-register {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px 20px;
    font-size: .92rem;
  }
  .acc-register li { display: flex; flex-direction: column; gap: 2px; padding: 10px 0; border-top: 1px solid var(--border, #e5e5e5); }
  .acc-register strong { font-weight: 600; }
  .acc-register span { color: var(--mid, #444); }
  .acc-register a { color: var(--yellow-700, #9a6c00); text-decoration: underline; }

  .author-note { padding: 28px 0 40px; border-top: 1px solid var(--border, #e5e5e5); }
  .author-note p { margin: 0; max-width: 72ch; color: var(--mid, #444); font-size: .95rem; line-height: 1.65; }
  .author-dates { margin-top: 6px !important; font-size: .88rem !important; }
</style>
