---
import UtilityBar from '../components/UtilityBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { KNOWS_ABOUT } from '../data/homepage';

const SITE = 'https://surreycontracting.co.uk';

// LocalBusiness structured data, emitted on every page. Service pages and the
// homepage reference this node via its @id.
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE}/#business`,
  name: 'Surrey Contracting Limited',
  url: SITE,
  logo: `${SITE}/assets/logo-color.png`,
  image: `${SITE}/assets/logo-transparent.png`,
  telephone: '+441483323568',
  email: 'info@surreycontracting.co.uk',
  description:
    'Groundworks, earthworks and demolition contractor based in Send, near Woking, Surrey. Self-delivered enabling works, site clearance, drainage, foundations, bulk excavation and demolition across Surrey and the Home Counties.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Unit 3, Tannery House, Tannery Lane, Send',
    addressLocality: 'Woking',
    addressRegion: 'Surrey',
    postalCode: 'GU23 7EF',
    addressCountry: 'GB',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.295495, longitude: -0.525645 },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:30',
      closes: '17:30',
    },
  ],
  areaServed: [
    'Cobham', 'Leatherhead', 'Guildford', 'Esher', 'Woking', 'Reigate',
    'Dorking', 'Epsom', 'Weybridge', 'Kingston upon Thames', 'Redhill', 'Surbiton',
  ].map((name) => ({ '@type': 'Place', name })),
  sameAs: [
    'https://www.linkedin.com/company/surrey-contracting/',
    'https://www.instagram.com/surreycontracting',
    'https://www.facebook.com/surreycontracting',
  ],
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'Companies House', value: '15877451' },
    { '@type': 'PropertyValue', propertyID: 'VAT', value: '415 8380 91' },
  ],
  knowsAbout: KNOWS_ABOUT,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Groundworks', url: `${SITE}/groundworks` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bulk Earthworks & Excavation', url: `${SITE}/earthworks` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Demolition', url: `${SITE}/demolition` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Soft Strip-Out & Internal Demolition', url: `${SITE}/soft-strip-out` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Site Hoarding & Security', url: `${SITE}/site-hoarding` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Site Enabling Works', url: `${SITE}/site-enabling-works` } },
    ],
  },
};

interface Props {
  title: string;
  description: string;
  /** Path for canonical + og:url, e.g. "/services" (no trailing slash). Home = "/". */
  path?: string;
  ogTitle?: string;
  /** Absolute-from-root image path, e.g. "/assets/img/og.jpg" */
  ogImage?: string;
  /** Active top-level nav key: services | health-safety | sectors | projects | about | contact */
  active?: string;
}

const {
  title,
  description,
  path = '/',
  ogTitle,
  ogImage = '/assets/img/og-default.jpg',
  active,
} = Astro.props;

const canonical = path === '/' ? SITE : SITE + path;
---
<!doctype html>
<html lang="en">
<head>
  <!-- Google Consent Mode v2: deny by default. The CookieYes CMP (loaded via
       GTM-TR97QJZB) updates consent to granted when the visitor accepts. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500,
    });
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TR97QJZB');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#E6A91A" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Surrey Contracting Limited" />
  <meta property="og:locale" content="en_GB" />
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={SITE + ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={SITE + ogImage} />}
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/styles.css" />
  <slot name="head" />
  <!-- TruConversion: loaded only after CookieYes analytics consent (PECR).
       Listens for cookieyes_banner_load (returning visitors) and
       cookieyes_consent_update (in-session choice); never loads otherwise. -->
  <script is:inline>
  (function () {
    var loaded = false;
    function loadTruConversion() {
      if (loaded) return;
      loaded = true;
      window._tip = window._tip || [];
      var d = document, id = 'ti-js';
      if (d.getElementById(id)) return;
      var tjs = d.getElementsByTagName('script')[0];
      var js = d.createElement('script');
      js.id = id;
      js.async = true;
      js.src = 'https://app.truconversion.com/ti-js/64315/df27a.js';
      tjs.parentNode.insertBefore(js, tjs);
    }
    function analyticsGranted(c) {
      if (!c || typeof c !== 'object') return false;
      if (Array.isArray(c.accepted)) return c.accepted.indexOf('analytics') !== -1;
      if (c.categories && typeof c.categories === 'object') {
        return c.categories.analytics === true && c.isUserActionCompleted !== false;
      }
      return false;
    }
    function check(c) { if (analyticsGranted(c)) loadTruConversion(); }
    document.addEventListener('cookieyes_banner_load', function (e) { check(e && e.detail); });
    document.addEventListener('cookieyes_consent_update', function (e) { check(e && e.detail); });
    try { if (typeof window.getCkyConsent === 'function') check(window.getCkyConsent()); } catch (err) {}
  })();
  </script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TR97QJZB"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <UtilityBar />
  <Nav active={active} />
  <slot />
  <Footer />
  <script>
    import '../scripts/app.js';
  </script>
  <!-- YourTradeQuotes Enquiry Connector -->
  <script is:inline>
  (function() {
    var API_KEY = 'ytq_live_demo_key_12345';
    var ENDPOINT = 'https://europe-west2-yourtradequotes.cloudfunctions.net/submitEnquiry';
    function extractFields(f) {
      var d = {}, cb = {};
      var els = f.querySelectorAll('input,textarea,select');
      for (var i = 0; i < els.length; i++) {
        var el = els[i], k = (el.name||el.id||'').trim();
        if (!k||el.type==='hidden'||el.type==='submit'||el.type==='button'||el.type==='reset') continue;
        if (el.type==='checkbox') { if (el.checked) cb[k] = cb[k] ? cb[k]+', '+(el.value||k) : (el.value||k); }
        else if (el.type==='radio') { if (el.checked) d[k] = el.value; }
        else d[k] = el.value||'';
      }
      for (var c in cb) d[c] = cb[c];
      return d;
    }
    var existing = document.querySelector('form[data-ytq-form]');
    if (!existing) return;
    existing.addEventListener('submit', function() {
      var p = JSON.stringify(Object.assign(extractFields(existing), {apiKey:API_KEY, source:'Website'}));
      if (navigator.sendBeacon) { navigator.sendBeacon(ENDPOINT, new Blob([p],{type:'application/json'})); }
      else { fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:p}); }
    });
  })();
  </script>
</body>
</html>
