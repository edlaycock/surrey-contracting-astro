---
interface Props {
  name: string;
  slug: string;
  description: string;
  /** Town name for a location page. Omit for the main service pages, which
   *  keep the regional area. */
  areaServedTown?: string;
  /** Breadcrumb label for the final crumb. Defaults to `name`. */
  crumbName?: string;
  /** Second breadcrumb. Defaults to Services. Location pages sit under their
   *  service page instead. */
  parent?: { name: string; slug: string };
}
const { name, slug, description, areaServedTown, crumbName, parent } = Astro.props;
const site = 'https://surreycontracting.co.uk';
const up = parent ?? { name: 'Services', slug: 'services' };

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name,
  serviceType: name,
  description,
  url: `${site}/${slug}`,
  // Reference the LocalBusiness node emitted site-wide by BaseLayout.
  provider: { '@id': `${site}/#business` },
  areaServed: areaServedTown
    ? { '@type': 'City', name: areaServedTown, containedInPlace: { '@type': 'AdministrativeArea', name: 'Surrey' } }
    : { '@type': 'AdministrativeArea', name: 'Surrey, London & the South East' },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: up.name, item: `${site}/${up.slug}` },
    { '@type': 'ListItem', position: 3, name: crumbName ?? name, item: `${site}/${slug}` },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(service)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
