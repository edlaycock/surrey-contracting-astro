---
/**
 * Full page template for the six service pages from the Oct 2026 design
 * handoff (/demolition, /soft-strip-out, /site-hoarding, /site-enabling-works,
 * /sectors, /health-safety). Content comes from src/data/servicePages.ts;
 * styles are the .sp-* rules in public/styles.css.
 *
 * Section order follows the design: hero, intro, cards, core services
 * (Sectors), process, accreditation strip, split, H&S extras, case studies,
 * FAQs, CTA band. Sections a page has no content for are omitted.
 *
 * FAQs: the page's `faqs` array drives both the visible <details> list and the
 * FAQPage JSON-LD, so the two cannot drift apart. The first item is open.
 * No quote form here: the CTAs link to /contact (one quoteForm per page rule).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSchema from './ServiceSchema.astro';
import ProjectsByCategory from './ProjectsByCategory.astro';
import { ACCREDITATION_LOGOS } from '../data/homepage';
import {
  PROCESS_ICONS,
  SECTORS_CORE_SERVICES,
  SERVICE_PAGES,
  type ServiceImage,
} from '../data/servicePages';

type Crumb = { name: string; href?: string };

interface Props {
  pageKey: keyof typeof SERVICE_PAGES;
  title: string;
  description: string;
  /** e.g. "/soft-strip-out" */
  path: string;
  active?: string;
  /** Breadcrumb after Home. Every entry but the last needs an href. */
  crumbs: Crumb[];
  /** Emit Service JSON-LD for this page. Omit for non-service pages (Sectors, H&S). */
  service?: { name: string; description: string };
  /** Primary hero button target. */
  heroCtaHref?: string;
  /** Hide the hero eyebrow when it only repeats the breadcrumb. */
  hideHeroEyebrow?: boolean;
  /** Case-study cards, placed just before the FAQs (or the CTA band). */
  projects?: { heading: string; category?: string; eyebrow?: string };
}

const {
  pageKey,
  title,
  description,
  path,
  active = 'services',
  crumbs,
  service,
  heroCtaHref = '/contact',
  hideHeroEyebrow = false,
  projects,
} = Astro.props;

const p = SERVICE_PAGES[pageKey];
const SITE = 'https://surreycontracting.co.uk';
const PHONE_HREF = 'tel:01483323568';
const EMAIL = 'info@surreycontracting.co.uk';

// Approved accreditation logos shown in the design: Constructionline Gold,
// CHAS and SSIP. Logos only, no text block, numbers or register links.
const ACC_SHOWN = ['constructionline-gold', 'chas', 'ssip'];
const ACC_DIMS: Record<string, [number, number]> = {
  'constructionline-gold': [600, 302],
  chas: [600, 371],
  ssip: [1003, 646],
};
const accLogos = ACC_SHOWN.map((key) => {
  const logo = ACCREDITATION_LOGOS.find((l) => l.logo.endsWith(`/${key}.webp`));
  if (!logo) throw new Error(`ServicePage: accreditation logo "${key}" missing from ACCREDITATION_LOGOS`);
  const [w, h] = ACC_DIMS[key];
  return { ...logo, w, h };
});

// Responsive sources. Images wider than 1280px also have a -1280.webp
// variant. Cards, intro, split and panel images are capped at 1280w (they
// never display wider than ~620 CSS px); only the hero offers the full file.
const src1280 = (img: ServiceImage) => (img.w > 1280 ? img.src.replace(/\.webp$/, '-1280.webp') : null);
const srcset = (img: ServiceImage, full = false) => {
  const set = [`${img.src640} ${img.w640}w`];
  const mid = src1280(img);
  if (mid) set.push(`${mid} 1280w`);
  if (img.w > img.w640 && (full || !mid)) set.push(`${img.src} ${img.w}w`);
  return set.length > 1 ? set.join(', ') : undefined;
};

const faqSchema = p.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: p.faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

// The eyebrow is dropped when it only repeats the current breadcrumb
// (Sectors, Health & Safety) or is itself a breadcrumb (Site Enabling Works).
const showEyebrow =
  !hideHeroEyebrow && p.hero.eyebrow.toLowerCase() !== crumbs[crumbs.length - 1].name.toLowerCase();

const slug = path.replace(/^\//, '');
const parents = crumbs.slice(0, -1).map((c) => ({ name: c.name, slug: (c.href ?? '').replace(/^\//, '') }));
const crumbName = crumbs[crumbs.length - 1].name;
// Non-service pages still get a BreadcrumbList.
const breadcrumbOnly = service
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        ...crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: c.name,
          item: `${SITE}${c.href ?? path}`,
        })),
      ],
    };
---
<BaseLayout title={title} description={description} path={path} active={active} ogImage={p.hero.img.src}>
  {service && (
    <ServiceSchema slot="head" name={service.name} slug={slug} description={service.description} crumbName={crumbName} parents={parents} />
  )}
  {breadcrumbOnly && <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbOnly)} />}
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}

<section class="sp-hero">
  <div class="sp-hero-media" aria-hidden="true">
    <img
      src={p.hero.img.src}
      srcset={srcset(p.hero.img, true)}
      sizes="(max-width: 820px) 100vw, 64vw"
      alt=""
      width={p.hero.img.w}
      height={p.hero.img.h}
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="sp-hero-fade" aria-hidden="true"></div>
  <div class="container sp-hero-inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {crumbs.map((c) => (
        <Fragment>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          {c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </Fragment>
      ))}
    </nav>
    {showEyebrow && <span class="sp-eyebrow sp-eyebrow-light">{p.hero.eyebrow}</span>}
    <h1 class="sp-hero-title">{p.hero.a} <br /><span>{p.hero.b}</span></h1>
    {p.hero.tag && <p class="sp-hero-tag">{p.hero.tag}</p>}
    <p class="sp-hero-text">{p.hero.text}</p>
    <div class="sp-hero-ctas">
      <a href={heroCtaHref} class="btn btn-yellow">{p.hero.cta} <span aria-hidden="true">→</span></a>
      {p.hero.cta2 && <a href={p.hero.cta2.href} class="btn btn-ghost-light">{p.hero.cta2.label}</a>}
    </div>
  </div>
</section>

<section class={p.intro.img ? 'sp-intro' : 'sp-intro sp-intro-full'} id="our-approach">
  <div class="container sp-intro-grid">
    <div class="sp-intro-copy">
      <span class="sp-eyebrow">{p.intro.eyebrow}</span>
      <h2 class="sp-h2">{p.intro.h}</h2>
      {p.intro.paras.map((t) => <p>{t}</p>)}
    </div>
    {p.intro.img && (
      <div class="sp-intro-media">
        <img
          src={p.intro.img.src640}
          srcset={srcset(p.intro.img)}
          sizes="(max-width: 880px) 100vw, 50vw"
          alt={p.intro.img.alt}
          width={p.intro.img.w640}
          height={p.intro.img.h640}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </div>
</section>

<section class={`sp-cards${p.grey ? ' sp-cards-grey' : ''}`}>
  <div class={`container sp-card-grid sp-card-grid-${p.cols}`}>
    {p.cards.map((c) => {
      const Tag = c.href ? 'a' : 'div';
      return (
        <Tag class={`sp-card${c.href ? ' sp-card-link' : ''}`} href={c.href}>
          <div class="sp-card-media">
            <img
              src={c.img.src640}
              srcset={srcset(c.img)}
              sizes={p.cols === 2 ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw'}
              alt={c.img.alt}
              width={c.img.w640}
              height={c.img.h640}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="sp-card-body">
            <div class="sp-card-copy">
              <h3>{c.t}</h3>
              <span class="sp-rule" aria-hidden="true"></span>
              <p>{c.d}</p>
            </div>
            {/* Arrow only on linked cards: never an arrow without a link. */}
            {c.href && <span class="sp-card-arrow" aria-hidden="true">→</span>}
          </div>
        </Tag>
      );
    })}
  </div>
</section>

{pageKey === 'sectors' && (
  <section class="sp-core">
    <div class="container">
      <div class="sp-core-head">
        <div>
          <span class="sp-eyebrow sp-eyebrow-light">Our services</span>
          <h2 class="sp-h2 sp-h2-light">Our <span>Core Services.</span></h2>
        </div>
        <p>A complete range of demolition, site enabling, bulk earthworks and groundworks services to support projects across all sectors.</p>
      </div>
      <div class="sp-core-grid">
        {SECTORS_CORE_SERVICES.map((s) => (
          <a class="sp-core-card" href={s.href}>
            <div class="sp-core-media">
              <img src={s.img.src640} srcset={srcset(s.img)} sizes="(max-width: 760px) 100vw, 25vw" alt={s.img.alt} width={s.img.w640} height={s.img.h640} loading="lazy" decoding="async" />
            </div>
            <div class="sp-card-body">
              <div class="sp-card-copy">
                <h3>{s.t}</h3>
                <span class="sp-rule" aria-hidden="true"></span>
                <p>{s.d}</p>
              </div>
              <span class="sp-card-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <div class="sp-core-links">
        <a href="/soft-strip-out">Soft Strip-Out &amp; Internal Demolition</a>
        <span aria-hidden="true">|</span>
        <a href="/site-hoarding">Site Hoarding &amp; Security</a>
      </div>
    </div>
  </section>
)}

{p.process && (
  <section class="sp-process">
    <div class="container">
      <span class="sp-eyebrow sp-eyebrow-light">{p.process.eyebrow}</span>
      <h2 class="sp-h2 sp-h2-light">{p.process.h}</h2>
      <ol class="sp-steps">
        {p.process.steps.map((s, i) => (
          <li>
            <span class="sp-step-icon" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={PROCESS_ICONS[s.icon]} /></svg>
            </span>
            <div>
              <span class="sp-step-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{p.accredStrip && (
  <div class="sp-acc-strip">
    <ul class="sp-acc-logos" aria-label="Accreditations">
      {accLogos.map((l) => (
        <li><img src={l.logo} alt={l.alt} width={l.w} height={l.h} loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  </div>
)}

{p.splits.map((sp) => (
  <section class="sp-split">
    <div class="container sp-split-grid">
      <div class="sp-split-media">
        <img
          src={sp.img.src640}
          srcset={srcset(sp.img)}
          sizes="(max-width: 880px) 100vw, 50vw"
          alt={sp.img.alt}
          width={sp.img.w640}
          height={sp.img.h640}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="sp-split-copy">
        <span class="sp-eyebrow">{sp.eyebrow}</span>
        <h2 class="sp-h2">{sp.h}</h2>
        {sp.paras.map((t) => <p>{t}</p>)}
        {sp.accred && (
          <ul class="sp-acc-logos sp-acc-logos-inline" aria-label="Accreditations">
            {accLogos.map((l) => (
              <li><img src={l.logo} alt={l.alt} width={l.w} height={l.h} loading="lazy" decoding="async" /></li>
            ))}
          </ul>
        )}
        {sp.btn && <a href={sp.btn.href} class="btn btn-yellow sp-split-btn">{sp.btn.label} <span aria-hidden="true">→</span></a>}
      </div>
    </div>
  </section>
))}

{p.asbestosImg && (
  <section class="sp-hs-extras">
    <div class="container sp-hs-extras-inner">
      <div class="sp-panel sp-asbestos">
        <div class="sp-asbestos-media">
          <img src={p.asbestosImg.src640} srcset={srcset(p.asbestosImg)} sizes="(max-width: 880px) 100vw, 33vw" alt={p.asbestosImg.alt} width={p.asbestosImg.w640} height={p.asbestosImg.h640} loading="lazy" decoding="async" />
        </div>
        <div class="sp-asbestos-copy">
          <span class="sp-eyebrow">Asbestos &amp; specialist services</span>
          <h2 class="sp-h2 sp-h2-sm">Asbestos management</h2>
          <p>Where asbestos-containing materials are identified, we work with appropriately licensed and competent specialist contractors to undertake survey, removal and disposal in line with current regulations.</p>
        </div>
      </div>
      <div class="sp-panel sp-hs-acc">
        <div>
          <span class="sp-eyebrow">Accreditations</span>
          <h2 class="sp-h2 sp-h2-sm">Industry recognised.</h2>
          <p>Our management systems and processes are supported by:</p>
        </div>
        <ul class="sp-acc-logos" aria-label="Accreditations">
          {accLogos.map((l) => (
            <li><img src={l.logo} alt={l.alt} width={l.w} height={l.h} loading="lazy" decoding="async" /></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

{projects && <ProjectsByCategory heading={projects.heading} category={projects.category} eyebrow={projects.eyebrow} />}

{p.faqs.length > 0 && (
  <section class="sp-faq">
    <div class="container sp-faq-grid">
      <div class="sp-faq-intro">
        <span class="sp-eyebrow">Frequently asked questions</span>
        <h2 class="sp-h2">Your questions answered.</h2>
        {p.faqIntro && <p>{p.faqIntro}</p>}
      </div>
      <div class="faq-list sp-faq-list">
        {p.faqs.map(({ q, a }, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="sp-cta">
  <div class="sp-cta-bg" aria-hidden="true">
    <img src={p.hero.img.src640} srcset={srcset(p.hero.img)} sizes="100vw" alt="" width={p.hero.img.w640} height={p.hero.img.h640} loading="lazy" decoding="async" />
  </div>
  <div class="container sp-cta-row">
    <div class="sp-cta-copy">
      <span class="sp-eyebrow sp-eyebrow-light">Get in touch</span>
      <h2 class="sp-h2 sp-h2-light">{p.cta.h}</h2>
      <p>{p.cta.t}</p>
    </div>
    <div class="sp-cta-actions">
      <a href="/contact" class="btn btn-yellow">Request a quote <span aria-hidden="true">→</span></a>
      <a href={PHONE_HREF} class="sp-cta-contact sp-cta-phone">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        01483 323568
      </a>
      <a href={`mailto:${EMAIL}`} class="sp-cta-contact">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        {EMAIL}
      </a>
    </div>
  </div>
</section>
</BaseLayout>
