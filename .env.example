# Copy to `.env` for local dev. On the VPS, put the server-only values in `$DEPLOY_PATH/.env`, which docker-compose.yml reads via env_file (see DEPLOY.md).
# NEVER commit the real .env.

# --- Email (quote/contact form) via SMTP2GO HTTP API ---
# API key from https://app.smtp2go.com (Settings → API Keys); starts with "api-"
SMTP2GO_API_KEY=api-XXXXXXXXXXXXXXXX
# Where enquiries are delivered:
CONTACT_TO=info@surreycontracting.co.uk
# From address — the sender domain must be verified in SMTP2GO:
CONTACT_FROM=Surrey Contracting Website <website@surreycontracting.co.uk>
# Optional: SMTP2GO API URL override, for local testing against a stub only.
# SMTP2GO_ENDPOINT=

# --- YourTradeQuotes (enquiries copied into Surrey Contracting's YTQ account) ---
# Server-only secret key. Installed on the VPS by scripts/ytq-connect.sh from a
# one-time claim code (run the deploy with ytq_claim_code, see DEPLOY.md);
# never in page code, never in the repo, never a GitHub secret.
# Unset = the relay is skipped. Leave it empty here.
YTQ_SECRET_KEY=
# Optional: endpoint override, for local testing against a stub only.
# YTQ_ENDPOINT=

# --- Sanity (case studies / projects CMS) ---
# projectId + dataset are public (safe to expose in the client build).
PUBLIC_SANITY_PROJECT_ID=mhqgpyb9
PUBLIC_SANITY_DATASET=production
