{
  "version": 1,
  "description": "Forbidden content patterns both tracks run on every text field before publish. Portable syntax only, common to ECMAScript (u flag) and PCRE (u and D modifiers): explicit character classes, no \\d \\w \\s \\b, no dot outside a class, no inline flags, no possessive quantifiers; both loaders refuse a pattern that breaks this. Text is folded first (text-folding.v1.json, core/spec/privacy.md). scope everywhere = every scanned string including the private consent fields; scope public = strings a reader can see. identifiers true = also run on id and ref, whose hyphens and underscores are read as spaces; identifiers separated = run on an id or ref only when it contains a hyphen or underscore, because a random unbroken id can spell a keyword by chance.",
  "skip_keys": [
    "schema_version",
    "version",
    "source",
    "status",
    "completed_month",
    "published_at",
    "modified_at",
    "unpublished_at",
    "confirmed_at",
    "ticked_at",
    "withdrawn_at",
    "role",
    "sha256",
    "key",
    "wording_version",
    "customer_permission"
  ],
  "identifier_keys": [
    "id",
    "ref"
  ],
  "hyphenated_keys": [
    "id",
    "ref",
    "slug"
  ],
  "private_keys": [
    "note",
    "withdrawn_reason",
    "confirmed_by",
    "ticked_by"
  ],
  "patterns": [
    {
      "code": "postcode",
      "scope": "everywhere",
      "ci": false,
      "identifiers": true,
      "pattern": "(?<![A-Za-z0-9])(?:[Gg][Ii][Rr][ ./,_-]{0,3}0[Aa]{2}|[A-PR-UWYZa-pr-uwyz][A-HK-Ya-hk-y]?[0-9][0-9A-HJKPSTUWa-hjkpstuw]?[ ./,_-]{0,3}(?![0-9](?:ft|st|nd|rd|th|yd|lb|ah|Ah|hz|Hz|db|dB)(?![A-Za-z0-9]))[0-9][ABD-HJLNP-UW-Zabd-hjlnp-uw-z]{2})(?![A-Za-z0-9])"
    },
    {
      "code": "email",
      "scope": "everywhere",
      "ci": false,
      "identifiers": true,
      "pattern": "[A-Za-z0-9._%+-]+ {0,1}@ {0,1}[A-Za-z0-9-]+(?:[.][A-Za-z0-9-]+)*[.][A-Za-z]{2,}(?![A-Za-z0-9])"
    },
    {
      "code": "phone",
      "scope": "everywhere",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<!part number )(?<!part no )(?<!part no[.] )(?<!model number )(?<!model no )(?<!serial number )(?<!serial no )(?<!product code )(?<!item code )(?<!barcode )(?<!sku )(?<![0-9+])(?:(?:[+]|00)44[ ()./_-]{0,3}(?:0[ ()./_-]{0,3})?|44[ ()./_-]{0,3}(?=7)|0 {0,1})[1-9](?:[ ()./_-]{0,3}[0-9]){8,9}(?![0-9])"
    },
    {
      "code": "street_address",
      "scope": "everywhere",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9A-Za-z])[0-9]{1,4}[A-Za-z]?,? (?:[A-Z][A-Za-z'-]+[.]? ){1,3}(?:Road|Street|Avenue|Lane|Crescent|Grove|Mews|Rd|St|Ave)(?![A-Za-z])"
    },
    {
      "code": "street_address",
      "scope": "everywhere",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9A-Za-z])[0-9]{1,4}[A-Z]?,? (?:[A-Z][A-Z'-]+[.]? ){1,3}(?:ROAD|STREET|AVENUE|LANE|CRESCENT|GROVE|MEWS|RD|AVE)(?![A-Za-z])"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "[\u00a3\u20ac$] {0,1}[0-9]"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<!weighs )(?<!weighing )(?<!weighed )(?<!weigh )(?<![A-Za-z0-9.,])[0-9][0-9,.]*k? {0,1}(?:pounds|pound|quid|gbp|pence|euros|euro|dollars|usd|eur)(?![A-Za-z])(?! (?:in weight|of weight|weight|per square|of pressure|pressure|of force|lump hammer|club hammer|sledge hammer|sledgehammer|hammer|mallet))"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])gbp {0,1}[0-9]"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<![A-Za-z0-9.,])[0-9][0-9,.]* {0,1}grand(?![A-Za-z])"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])(?:cost|costs|costing|price|priced|paid|charged|quoted|budget|bill|total|worth|saved|saving)(?: (?:of|was|is|us|them|just|only|about|around|under|over|nearly|almost)){0,3} [0-9][0-9,.]*k(?![A-Za-z0-9])"
    },
    {
      "code": "price",
      "scope": "public",
      "ci": true,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])(?:cost|costs|costing|price|priced|paid|charged|quoted|budget|bill|worth)(?: (?:of|was|is|us|them|just|only|about|around|under|over|nearly|almost)){0,3}:? (?!(?:19|20)[0-9]{2} {0,1}(?:$|[.](?![0-9])|,(?![0-9])|[;:!?)]))[0-9][0-9,]{2,}(?:[.][0-9]{2})?(?= {0,1}(?:$|[.;:!?)]|,(?: (?![0-9])|$)|[+]|inc(?![A-Za-z])|plus(?![A-Za-z])|all in(?![A-Za-z])))"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9])(?:0?[1-9]|[12][0-9]|3[01])(?:st|nd|rd|th)? (?:of )?(?:[Jj][Aa][Nn][Uu][Aa][Rr][Yy]|[Ff][Ee][Bb][Rr][Uu][Aa][Rr][Yy]|[Aa][Pp][Rr][Ii][Ll]|[Jj][Uu][Nn][Ee]|[Jj][Uu][Ll][Yy]|[Aa][Uu][Gg][Uu][Ss][Tt]|[Ss][Ee][Pp][Tt][Ee][Mm][Bb][Ee][Rr]|[Oo][Cc][Tt][Oo][Bb][Ee][Rr]|[Nn][Oo][Vv][Ee][Mm][Bb][Ee][Rr]|[Dd][Ee][Cc][Ee][Mm][Bb][Ee][Rr]|[Ss][Ee][Pp][Tt]|[Jj][Aa][Nn]|[Ff][Ee][Bb]|[Aa][Pp][Rr]|[Jj][Uu][Nn]|[Jj][Uu][Ll]|[Aa][Uu][Gg]|[Ss][Ee][Pp]|[Oo][Cc][Tt]|[Nn][Oo][Vv]|[Dd][Ee][Cc]|March|MARCH|May|MAY|Mar|MAR)[.]?(?![A-Za-z])"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])(?:[Jj][Aa][Nn][Uu][Aa][Rr][Yy]|[Ff][Ee][Bb][Rr][Uu][Aa][Rr][Yy]|[Aa][Pp][Rr][Ii][Ll]|[Jj][Uu][Nn][Ee]|[Jj][Uu][Ll][Yy]|[Aa][Uu][Gg][Uu][Ss][Tt]|[Ss][Ee][Pp][Tt][Ee][Mm][Bb][Ee][Rr]|[Oo][Cc][Tt][Oo][Bb][Ee][Rr]|[Nn][Oo][Vv][Ee][Mm][Bb][Ee][Rr]|[Dd][Ee][Cc][Ee][Mm][Bb][Ee][Rr]|[Ss][Ee][Pp][Tt]|[Jj][Aa][Nn]|[Ff][Ee][Bb]|[Aa][Pp][Rr]|[Jj][Uu][Nn]|[Jj][Uu][Ll]|[Aa][Uu][Gg]|[Ss][Ee][Pp]|[Oo][Cc][Tt]|[Nn][Oo][Vv]|[Dd][Ee][Cc]|March|MARCH|May|MAY|Mar|MAR)[.]? (?:the )?(?:0?[1-9]|[12][0-9]|3[01])(?:st|nd|rd|th)(?![A-Za-z0-9])"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])(?:[Jj][Aa][Nn][Uu][Aa][Rr][Yy]|[Ff][Ee][Bb][Rr][Uu][Aa][Rr][Yy]|[Aa][Pp][Rr][Ii][Ll]|[Jj][Uu][Nn][Ee]|[Jj][Uu][Ll][Yy]|[Aa][Uu][Gg][Uu][Ss][Tt]|[Ss][Ee][Pp][Tt][Ee][Mm][Bb][Ee][Rr]|[Oo][Cc][Tt][Oo][Bb][Ee][Rr]|[Nn][Oo][Vv][Ee][Mm][Bb][Ee][Rr]|[Dd][Ee][Cc][Ee][Mm][Bb][Ee][Rr]|[Ss][Ee][Pp][Tt]|[Jj][Aa][Nn]|[Ff][Ee][Bb]|[Aa][Pp][Rr]|[Jj][Uu][Nn]|[Jj][Uu][Ll]|[Aa][Uu][Gg]|[Ss][Ee][Pp]|[Oo][Cc][Tt]|[Nn][Oo][Vv]|[Dd][Ee][Cc]|March|MARCH|May|MAY|Mar|MAR)[.]? (?:0?[1-9]|[12][0-9]|3[01]),? (?:19|20)[0-9]{2}(?![0-9])"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![A-Za-z])(?:[Jj][Aa][Nn][Uu][Aa][Rr][Yy]|[Ff][Ee][Bb][Rr][Uu][Aa][Rr][Yy]|[Aa][Pp][Rr][Ii][Ll]|[Jj][Uu][Nn][Ee]|[Jj][Uu][Ll][Yy]|[Aa][Uu][Gg][Uu][Ss][Tt]|[Ss][Ee][Pp][Tt][Ee][Mm][Bb][Ee][Rr]|[Oo][Cc][Tt][Oo][Bb][Ee][Rr]|[Nn][Oo][Vv][Ee][Mm][Bb][Ee][Rr]|[Dd][Ee][Cc][Ee][Mm][Bb][Ee][Rr]|[Ss][Ee][Pp][Tt]|[Jj][Aa][Nn]|[Ff][Ee][Bb]|[Aa][Pp][Rr]|[Jj][Uu][Nn]|[Jj][Uu][Ll]|[Aa][Uu][Gg]|[Ss][Ee][Pp]|[Oo][Cc][Tt]|[Nn][Oo][Vv]|[Dd][Ee][Cc]|March|MARCH|May|MAY|Mar|MAR)[.]? (?:0?[1-9]|[12][0-9]|3[01])(?= {0,1}(?:$|[.,;:!?)]))"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9/.-])(?:0?[1-9]|[12][0-9]|3[01])[/.-](?:0?[1-9]|1[0-2])[/.-](?:19|20)[0-9]{2}(?![0-9])"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9/.-])(?:0[1-9][/-](?:0?[1-9]|1[0-2])|(?:[1-9]|[12][0-9]|3[01])[/-]0[1-9])[/-][0-9]{2}(?![0-9/.-])"
    },
    {
      "code": "exact_date",
      "scope": "public",
      "ci": false,
      "identifiers": false,
      "pattern": "(?<![0-9])(?:19|20)[0-9]{2}[/-](?:0[1-9]|1[0-2])[/-](?:0[1-9]|[12][0-9]|3[01])(?![0-9])"
    },
    {
      "code": "reference",
      "scope": "public",
      "ci": true,
      "identifiers": "separated",
      "pattern": "(?<![A-Za-z])(?:ref|reference)[ .:#-]{0,3}(?:(?:no|number|num|#)[ .:#-]{0,3})?(?=[A-Za-z0-9-]*[0-9])[A-Za-z0-9-]{3,}"
    },
    {
      "code": "reference",
      "scope": "public",
      "ci": true,
      "identifiers": "separated",
      "pattern": "(?<![A-Za-z])(?:job|quote|quotation|invoice|enquiry|order|po|inv|enq|quo)[ .:#-]{0,3}(?:(?:no|number|num|ref|reference|#)[ .:#-]{0,3})?[A-Za-z]{0,4}-?[0-9]{3,}(?![0-9%]| ?(?:days|day|weeks|week|hours|hour|years|year|metres|metre|mm|cm|m|kg|percent)(?![A-Za-z]))"
    },
    {
      "code": "reference",
      "scope": "public",
      "ci": true,
      "identifiers": "separated",
      "pattern": "(?<![A-Za-z])(?:job|quote|quotation|invoice|enquiry|order|po|inv|enq|quo)[ .:#-]{0,3}(?:no|number|num|ref|reference|#)[ .:#-]{0,3}[A-Za-z0-9-]*[0-9]"
    }
  ]
}
