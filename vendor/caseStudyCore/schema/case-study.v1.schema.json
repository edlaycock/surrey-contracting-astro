{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cumulus:case-study-core:case-study:v1",
  "title": "Case study record, schema_version 1",
  "description": "The one record both tracks produce (WordPress plugin, YourTradeQuotes). Strict: no property outside this schema is accepted anywhere, so customer name, contact details, address, postcode, job or quote reference, exact dates, prices, internal notes and signatures have no place to live. Rules a schema cannot state (section order, photo pairs, times in order, forbidden content) are in the reference validators. minLength is applied by the reference validators to the text a reader would see (surrounding and repeated whitespace not counted). See core/spec/record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "source",
    "status",
    "title",
    "slug",
    "excerpt",
    "service_category",
    "location",
    "completed_month",
    "sections",
    "faqs",
    "photos"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "description": "Stable for the life of the case study. With version it is the idempotency key for publishing and delivery. Generated by the software (a UUID or a random document id), never built from a name, place or job number: it is scanned like text.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
    },
    "version": {
      "description": "1 for the first publish, then one higher on each later publish.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "source": {
      "enum": [
        "wordpress",
        "ytq"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "unpublished"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 110
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "excerpt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200
    },
    "service_category": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "location": {
      "description": "Town only. There is no street, postcode, coordinate or free-text location field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "town",
        "show_town"
      ],
      "properties": {
        "town": {
          "description": "Letters (including accented Latin letters, so Welsh and Gaelic names work), spaces, full stops, apostrophes and hyphens only, so a postcode or house number cannot be stored here.",
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[A-Za-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u017F][A-Za-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u017F .'\u2019-]*$"
        },
        "show_town": {
          "type": "boolean"
        }
      }
    },
    "completed_month": {
      "description": "Month only, YYYY-MM. A day cannot be stored.",
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
    },
    "sections": {
      "description": "Three to five of the five question-led sections, in the fixed order need, challenge, solution, work, result, no key twice (order and uniqueness are checked by the reference validators). work is always present. A section the facts cannot answer is left out, never padded. The question is the heading.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/section"
      },
      "contains": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "const": "work"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "faqs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/faq"
      }
    },
    "photos": {
      "description": "1 to 12 photos, exactly one with role hero.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/photo"
      },
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "hero"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "consent": {
      "$ref": "#/$defs/consent"
    },
    "social": {
      "$ref": "#/$defs/social"
    },
    "published_at": {
      "description": "When version 1 first went live. Never changes afterwards.",
      "$ref": "#/$defs/timestamp"
    },
    "modified_at": {
      "description": "When this version was published.",
      "$ref": "#/$defs/timestamp"
    },
    "unpublished_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "$comment": "Publish gate. A record that is or has been public must carry the consent record, its publish times, and a person's tick on every photo.",
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "published",
              "unpublished"
            ]
          }
        }
      },
      "then": {
        "required": [
          "consent",
          "published_at",
          "modified_at"
        ],
        "properties": {
          "photos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "checked"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "unpublished"
          }
        }
      },
      "then": {
        "required": [
          "unpublished_at"
        ],
        "properties": {
          "consent": {
            "type": "object",
            "required": [
              "withdrawn_at",
              "withdrawn_reason"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "unpublished_at": false
        }
      },
      "$comment": "Unpublish always records when and why on the consent record. It is how permission to publish ends, whatever the reason."
    },
    {
      "$comment": "Withdrawn permission and a live page cannot coexist.",
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "type": "object",
            "properties": {
              "withdrawn_at": false,
              "withdrawn_reason": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "UTC, to the second, always with Z, so two timestamps compare as plain strings.",
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "question": {
      "type": "string",
      "minLength": 8,
      "maxLength": 140
    },
    "section_answer": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1500
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answer"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "answer": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "role",
        "alt",
        "order",
        "width",
        "height",
        "sha256"
      ],
      "properties": {
        "ref": {
          "description": "Opaque handle generated by the software. Never a URL, a file name or anything built from a name or address: it ends up in public file names and is scanned like text.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
        },
        "role": {
          "enum": [
            "hero",
            "before",
            "after",
            "other"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "pair": {
          "description": "Ties one before photo to one after photo. Only on those two roles.",
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 2560
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 2560
        },
        "sha256": {
          "description": "Of the published derivative (metadata stripped), lower-case hex.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checked": {
          "$ref": "#/$defs/photo_check"
        }
      }
    },
    "photo_check": {
      "description": "A person's tick that the photo shows no faces, number plates, house numbers or documents. Absent means not ticked. It is never defaulted and never written by AI: there is no false value and no way to record a tick without who and when.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "confirmed_by",
        "confirmed_at"
      ],
      "properties": {
        "confirmed": {
          "const": true
        },
        "confirmed_by": {
          "$ref": "#/$defs/person_name"
        },
        "confirmed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "person_name": {
      "description": "The trade's or client's own staff member. Never the customer.",
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "consent": {
      "description": "See core/spec/consent.md. No default and no skip.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_permission",
        "confirmed_by",
        "confirmed_at",
        "wording_version"
      ],
      "properties": {
        "customer_permission": {
          "enum": [
            "yes_verbal",
            "yes_written",
            "yes_link",
            "not_identifiable"
          ]
        },
        "confirmed_by": {
          "$ref": "#/$defs/person_name"
        },
        "confirmed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "wording_version": {
          "enum": [
            "v1"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "withdrawn_at": {
          "$ref": "#/$defs/timestamp"
        },
        "withdrawn_reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "not_identifiable_statement": {
          "$ref": "#/$defs/not_identifiable_statement"
        }
      },
      "dependentRequired": {
        "withdrawn_at": [
          "withdrawn_reason"
        ],
        "withdrawn_reason": [
          "withdrawn_at"
        ]
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "customer_permission"
            ],
            "properties": {
              "customer_permission": {
                "const": "not_identifiable"
              }
            }
          },
          "then": {
            "required": [
              "not_identifiable_statement"
            ]
          },
          "else": {
            "properties": {
              "not_identifiable_statement": false
            }
          }
        }
      ]
    },
    "social": {
      "description": "See core/spec/social.md. The link is added by the composer, never typed into the caption.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption",
        "link_label"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "link_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "question",
        "answer"
      ],
      "properties": {
        "key": {
          "enum": [
            "need",
            "challenge",
            "solution",
            "work",
            "result"
          ]
        },
        "question": {
          "$ref": "#/$defs/question"
        },
        "answer": {
          "$ref": "#/$defs/section_answer"
        }
      }
    },
    "not_identifiable_statement": {
      "description": "The author's tick, with not_identifiable only, that no photo shows a house number, a number plate, a person or the front of the property. Wording in consent-wording.v1.json. Never defaulted, never written by AI.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticked_by",
        "ticked_at"
      ],
      "properties": {
        "ticked_by": {
          "$ref": "#/$defs/person_name"
        },
        "ticked_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
