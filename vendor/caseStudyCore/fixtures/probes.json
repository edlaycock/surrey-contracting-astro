      "raw": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "expected": "ok"
    },
    {
      "name": "L3 64 levels",
      "mode": "decode",
      "raw": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "expected": "throw"
    },
    {
      "name": "L4 pattern with backslash d",
      "mode": "schema",
      "schema": "{\"pattern\":\"^\\\\d$\"}",
      "raw": "\"1\"",
      "expected": "throw"
    },
    {
      "name": "L4 pattern with a bare dot",
      "mode": "schema",
      "schema": "{\"pattern\":\"^a.b$\"}",
      "raw": "\"a b\"",
      "expected": "throw"
    },
    {
      "name": "L4 pattern with an inline flag",
      "mode": "schema",
      "schema": "{\"pattern\":\"(?i)a\"}",
      "raw": "\"A\"",
      "expected": "throw"
    },
    {
      "name": "L4 pattern with a possessive quantifier",
      "mode": "schema",
      "schema": "{\"pattern\":\"a++\"}",
      "raw": "\"aa\"",
      "expected": "throw"
    },
    {
      "name": "L4 type as a list",
      "mode": "schema",
      "schema": "{\"type\":[\"string\",\"null\"]}",
      "raw": "\"a\"",
      "expected": "throw"
    },
    {
      "name": "L5 $ref cycle",
      "mode": "schema",
      "schema": "{\"$ref\":\"#/$defs/a\",\"$defs\":{\"a\":{\"$ref\":\"#/$defs/a\"}}}",
      "raw": "1",
