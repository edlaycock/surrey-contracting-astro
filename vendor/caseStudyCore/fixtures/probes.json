    },
    {
      "name": "unsupported keyword",
      "mode": "schema",
      "schema": "{\"type\":\"string\",\"format\":\"email\"}",
      "raw": "\"x\"",
      "expected": "throw"
    },
    {
      "name": "M5 minLength counts visible text",
      "mode": "schema",
      "schema": "{\"type\":\"string\",\"minLength\":3}",
      "raw": "\"  a   \\n \"",
      "expected": "schema.min_length"
    },
    {
      "name": "1 and 1.0 are the same number",
      "mode": "schema",
      "schema": "{\"const\":1}",
      "raw": "1.0",
      "expected": "ok"
    },
    {
      "name": "L9 run-together sentences",
      "mode": "sentences",
      "text": "One.Two.Three.Four.",
