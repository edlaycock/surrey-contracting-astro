{
  "description": "Small cases run through both implementations in exactly the same way, mostly the reproductions from the independent review of core v1. expected is the outcome as a string: an error code, ok, throw, true or false, a count, or the canonical text.",
  "probes": [
    {
      "name": "H1 hyphenated term",
      "mode": "term",
      "text": "x Smith-Jones y",
      "term": "Smith-Jones",
      "expected": "true"
    },
    {
      "name": "H1 hyphenated phone term",
      "mode": "term",
      "text": "ring 07700 900123",
      "term": "07700-900123",
      "expected": "true"
    },
    {
      "name": "term matches across hyphen and space",
      "mode": "term",
      "text": "Sam-Carter was pleased",
      "term": "Sam Carter",
      "expected": "true"
    },
    {
      "name": "term matches curly apostrophe",
      "mode": "term",
      "text": "Mr O\u2019Brien",
      "term": "O'Brien",
      "expected": "true"
    },
    {
      "name": "term matches combining accent",
      "mode": "term",
      "text": "Zoe\u0308 said",
      "term": "Zo\u00eb",
      "expected": "true"
    },
    {
      "name": "term matches fullwidth letters",
      "mode": "term",
      "text": "\uff33\uff41\uff4d Carter",
      "term": "Sam Carter",
      "expected": "true"
    },
    {
      "name": "term does not match inside a word",
      "mode": "term",
      "text": "A framanded gate",
      "term": "Raman",
      "expected": "false"
    },
    {
      "name": "phone term is not built from unrelated numbers",
      "mode": "term",
      "text": "2026, 1.8m, 30 posts, 7700 x 900 and 123",
      "term": "07700 900123",
      "expected": "false"
    },
    {
      "name": "phone term in international form",
      "mode": "term",
      "text": "Ring +44 7700 900123 today",
      "term": "07700 900123",
      "expected": "true"
    },
    {
      "name": "L12 town with full stop",
      "mode": "term",
      "text": "A job in St Albans",
      "term": "St. Albans",
      "expected": "true"
    },
    {
      "name": "L12 common-word town still matches (documented)",
      "mode": "term",
      "text": "Bath and shower room refit",
      "term": "Bath",
      "expected": "true"
    },
    {
      "name": "one character term ignored",
      "mode": "term",
      "text": "Any text at all",
      "term": "x",
      "expected": "false"
    },
    {
      "name": "M2 bare string term",
      "mode": "options",
      "options": "{\"forbiddenTerms\":[\"Sam Carter\"]}",
      "expected": "throw"
    },
    {
      "name": "M2 term with wrong key",
      "mode": "options",
      "options": "{\"forbiddenTerms\":[{\"label\":\"name\",\"name\":\"Sam Carter\"}]}",
      "expected": "throw"
    },
    {
      "name": "M2 option spelt as in the fixtures",
      "mode": "options",
      "options": "{\"forbidden_terms\":[{\"label\":\"name\",\"value\":\"Sam Carter\"}]}",
      "expected": "throw"
    },
    {
      "name": "M2 well-formed terms",
      "mode": "options",
      "options": "{\"forbiddenTerms\":[{\"label\":\"name\",\"value\":\"Sam Carter\"}]}",
      "expected": "ok"
    },
    {
      "name": "M3 builder refuses unvalidated text",
      "mode": "jsonld",
      "fixture": "valid-full",
      "context": "site-context.json",
      "set_record": [
        [
          [
            "title"
          ],
          "Sam Carter, 14 Acacia Road KT12 4RG, 07700 900123, \u00a34500"
        ]
      ],
      "set_context": [],
      "expected": "jsonld.record_invalid"
    },
